# Copy to .env (or set these in the shell / CI) to wire the frontend
# to the real backend. Without them the app runs on bundled demo data.

# Base URL of the InsightPlus API. Must end with "/".
# All endpoints are resolved against this (see src/api/endpoints.js).
VITE_API_URL=http://localhost:8000/api/v1/

# Set to "false" to call the real API above. Keep "true" (or unset)
# to use the demo data bundled under src/services/mock/.
VITE_USE_MOCK=true